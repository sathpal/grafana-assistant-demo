<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>{"ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC}","level":"%level","logger":"%logger{30}","message":"%replace(%replace(%message){'\\','\\\\'}){'"','\\"'}","trace_id":"%X{trace_id}","span_id":"%X{span_id}","service_name":"cortex-publisher-service"}%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
  <logger name="org.apache.kafka" level="WARN"/>
  <logger name="org.hibernate" level="WARN"/>
</configuration>
