# ---- Grafana Cloud · OTLP ingest (portal -> stack -> Send data -> OpenTelemetry) --------------------
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=123456
GRAFANA_CLOUD_API_TOKEN=glc_...          # metrics:write logs:write traces:write

# ---- Grafana Cloud · API (dashboards, alert rules, annotations, and the MCP server) -----------------
GRAFANA_URL=https://<your-stack>.grafana.net
GRAFANA_SA_TOKEN=glsa_...                # service account token: Viewer to read, Editor for Part 5's writes

# ---- Postgres (in the compose file) -----------------------------------------------------------------
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_dev_only
POSTGRES_DB=cortex

# ---- optional knobs ---------------------------------------------------------------------------------
KAFKA_CONSUMER_CONCURRENCY=1             # the single lane that Part 3 exposes
PUBLISHER_RENDER_MS=30
MEDIA_RENDER_MS=40
MEDIA_CACHE_TTL_SECONDS=3600
BATCH_SIZE=25
BATCH_CONCURRENCY=4
BATCH_INTERVAL_S=300
READER_RPS=5
